; Upstream's tests call "ocamlformat". The binaries field below puts the
; fork's binary under that name first on PATH, ahead of an ocamlformat in the
; opam switch.

(cram
 (package ocamlformat-mlx)
 (deps %{bin:ocamlformat} %{bin:ocamlformat-mlx}))

(cram
 (applies_to large_string conf removed_option repl_file_errors debug)
 (enabled_if
  (<> %{os_type} Win32)))

; Avoid unstable output from Cmdliner

(env
 (_
  (env-vars
   (TERM dumb))
  (binaries
   (../../bin/ocamlformat/ocamlformat.exe as ocamlformat))))
